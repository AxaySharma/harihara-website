---
import '../styles/global.css';
import FontLoader from '../components/FontLoader.astro';
import Header from '../components/Header.astro';
import { languages, getVisibleLanguages } from '../i18n/languages.config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
  title?: string;
  description?: string;
}

const { lang = 'en', title, description } = Astro.props;
const t = useTranslations(lang);
const langConfig = languages[lang] || languages.en;

const siteName = t('site_name');
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} | Industrial Bromine Recovery`;
const metaDescription = description || t('hero.lead');

const showDrafts = import.meta.env.SHOW_DRAFT_LANGUAGES === 'true';
const visibleLocales = getVisibleLanguages(showDrafts);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://harihara.net';
const canonicalPath = lang === 'en' ? '/' : `/${lang}/`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
---

<!doctype html>
<html lang={langConfig.htmlLang} dir={langConfig.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Hreflang tags for visible languages -->
    {visibleLocales.map((locale) => {
      const href = locale.code === 'en' ? `${siteUrl}/` : `${siteUrl}/${locale.code}/`;
      return <link rel="alternate" hreflang={locale.htmlLang} href={href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Language auto-detect script (runs on initial visit) -->
    {lang === 'en' && <script is:inline src="/scripts/auto-detect.js" />}

    <FontLoader lang={lang} />
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-charcoal)] antialiased flex flex-col min-h-screen">
    <!-- Sticky editorial Header -->
    <Header lang={lang} />

    {lang !== 'en' && (
      <aside
        aria-label="Convenience translation note"
        class="bg-[var(--color-paper-light)] border-b border-[var(--color-border-subtle)] text-[11px] text-[var(--color-grey)] py-1.5 text-center px-4"
      >
        <p>{t('convenience_note')}</p>
      </aside>
    )}

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)] py-8 px-4 text-center text-xs text-[var(--color-grey)]">
      <div class="max-w-[78rem] mx-auto space-y-2">
        <p>Hari Hara Serenity Chemical LLP | LLPIN: ACR-8196 | GSTIN: 24AASFH7523H1Z5 | Limited Liability Partnership registered under the LLP Act, 2008</p>
      </div>
    </footer>
  </body>
</html>
