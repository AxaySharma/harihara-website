---
import '../styles/global.css';
import FontLoader from '../components/FontLoader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, getVisibleLanguages } from '../i18n/languages.config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
  title?: string;
  description?: string;
}

const { lang = 'en', title, description } = Astro.props;
const t = useTranslations(lang);
const langConfig = languages[lang] || languages.en;

const isNoIndex = import.meta.env.PUBLIC_NOINDEX === 'true' || process.env.PUBLIC_NOINDEX === 'true';

const siteName = t('site_name');
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} | Industrial Bromine Recovery`;
const metaDescription = description || t('hero.lead');

const showDrafts = import.meta.env.SHOW_DRAFT_LANGUAGES === 'true';
const visibleLocales = getVisibleLanguages(showDrafts);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://harihara.net';
const canonicalPath = lang === 'en' ? '/' : `/${lang}/`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = `${siteUrl}/og-default.png`;

// JSON-LD Organization Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Hari Hara Serenity Chemical LLP",
  "url": siteUrl,
  "logo": `${siteUrl}/brand/logo-full.png`,
  "email": "Purchase@harihara.net",
  "telephone": "+91-9427134190",
  "address": [
    {
      "@type": "PostalAddress",
      "streetAddress": "Village Manaba, Taluka Rapar",
      "addressLocality": "District Kachchh",
      "addressRegion": "Gujarat",
      "addressCountry": "IN"
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "Plot No. 390, Shiv Residency, Shiv Aaradhana Society, Bhuj Bypass",
      "addressLocality": "Bhuj, Kachchh",
      "addressRegion": "Gujarat",
      "postalCode": "370001",
      "addressCountry": "IN"
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "106, Ruby Monarch Arcade, Saki Vihar Road, Sakinaka, Andheri (East)",
      "addressLocality": "Mumbai",
      "addressRegion": "Maharashtra",
      "postalCode": "400072",
      "addressCountry": "IN"
    }
  ]
};
---

<!doctype html>
<html lang={langConfig.htmlLang} dir={langConfig.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {isNoIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph Tags -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Hreflang tags for visible languages -->
    {visibleLocales.map((locale) => {
      const href = locale.code === 'en' ? `${siteUrl}/` : `${siteUrl}/${locale.code}/`;
      return <link rel="alternate" hreflang={locale.htmlLang} href={href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Language auto-detect script (runs on initial visit) -->
    {lang === 'en' && <script is:inline src="/scripts/auto-detect.js" />}

    <FontLoader lang={lang} />
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-charcoal)] antialiased flex flex-col min-h-screen">
    <!-- Sticky editorial Header -->
    <Header lang={lang} />

    {lang !== 'en' && (
      <aside
        aria-label="Convenience translation note"
        class="bg-[var(--color-paper-light)] border-b border-[var(--color-border-subtle)] text-[0.875rem] text-[var(--color-secondary)] py-2 text-center px-4"
      >
        <p>{t('convenience_note')}</p>
      </aside>
    )}

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Comprehensive Footer -->
    <Footer lang={lang} />

    <!-- Scroll Reveal Client Script -->
    <script is:inline>
      (function() {
        if (!('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js-ready');
        const elements = document.querySelectorAll('.reveal-on-scroll');
        if (elements.length === 0) return;
        const observer = new IntersectionObserver(function(entries, obs) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.1 });
        elements.forEach(function(el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
