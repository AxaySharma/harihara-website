---
import '../styles/global.css';
import FontLoader from '../components/FontLoader.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { languages, getVisibleLanguages } from '../i18n/languages.config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
  title?: string;
  description?: string;
}

const { lang = 'en', title, description } = Astro.props;
const t = useTranslations(lang);
const langConfig = languages[lang] || languages.en;

const siteName = t('site_name');
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} | Industrial Bromine Recovery`;
const metaDescription = description || t('hero_subheading');

const showDrafts = import.meta.env.SHOW_DRAFT_LANGUAGES === 'true';
const visibleLocales = getVisibleLanguages(showDrafts);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://harihara.net';
const canonicalPath = lang === 'en' ? '/' : `/${lang}/`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
---

<!doctype html>
<html lang={langConfig.htmlLang} dir={langConfig.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang tags for all visible/published languages -->
    {visibleLocales.map((locale) => {
      const href = locale.code === 'en' ? `${siteUrl}/` : `${siteUrl}/${locale.code}/`;
      return <link rel="alternate" hreflang={locale.htmlLang} href={href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Language auto-detect script (runs on initial visit) -->
    {lang === 'en' && <script is:inline src="/scripts/auto-detect.js" />}

    <FontLoader lang={lang} />
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-charcoal)] antialiased flex flex-col min-h-screen">
    <header class="border-b border-[var(--color-border)] bg-[var(--color-paper-light)]/80 backdrop-blur-xs sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
        <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-2 group">
          <span class="font-label text-sm tracking-widest font-bold text-[var(--color-charcoal)] group-hover:text-[var(--color-crimson)] transition-colors">
            {t('short_name')}
          </span>
        </a>
        <div class="flex items-center gap-4">
          <LanguageSwitcher currentLang={lang} />
        </div>
      </div>
    </header>

    {lang !== 'en' && (
      <div class="bg-[var(--color-paper-light)] border-b border-[var(--color-border-subtle)] text-xs text-[var(--color-grey)] py-2 text-center px-4">
        <p>{t('convenience_note')}</p>
      </div>
    )}

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)] py-8 px-4 text-center text-xs text-[var(--color-grey)]">
      <div class="max-w-7xl mx-auto space-y-2">
        <p>Hari Hara Serenity Chemical LLP | LLPIN: ACR-8196 | GSTIN: 24AASFH7523H1Z5 | Limited Liability Partnership registered under the LLP Act, 2008</p>
      </div>
    </footer>
  </body>
</html>
