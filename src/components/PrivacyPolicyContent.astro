---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const siteName = t('site_name');
---

<BaseLayout
  lang={lang}
  title={t('legal.privacy_title')}
  description={t('legal.privacy_description')}
>
  <div class="py-[var(--section-space)] bg-[var(--color-paper)]">
    <div class="max-w-[70ch] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Non-English convenience notice if applicable -->
      {lang !== 'en' && (
        <div class="mb-8 p-4 bg-[var(--color-paper-light)] border border-[var(--color-border)] rounded-[2px] text-[0.875rem] text-[var(--color-secondary)]">
          <p>{t('legal.official_version_notice')}</p>
        </div>
      )}

      <!-- Header -->
      <header class="mb-10 pb-6 border-b border-[var(--color-border)]">
        <h1 class="font-heading text-[var(--text-xl)] sm:text-[var(--text-2xl)] text-[var(--color-charcoal)] mb-3">
          {t('legal.privacy_title')}
        </h1>
        <p class="text-[0.875rem] font-medium text-[var(--color-secondary)]">
          {t('legal.last_updated')} &bull; {siteName}
        </p>
      </header>

      <!-- Binding English content with lang="en" for screen readers -->
      <article lang="en" class="space-y-8 text-[var(--text-base)] text-[var(--color-charcoal)] leading-relaxed">
        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            1. Who We Are and Privacy Contact
          </h2>
          <p>
            Hari Hara Serenity Chemical LLP ("we", "our", or "us") is a Limited Liability Partnership registered in India under the Limited Liability Partnership Act, 2008 (LLPIN: ACR-8196). We are setting up a chemical facility at Rapar, Kachchh, Gujarat.
          </p>
          <p>
            For any questions, requests, or grievances regarding this Privacy Policy or personal data handling, please contact our designated privacy contact:
          </p>
          <div class="bg-[var(--color-paper-light)] p-4 border border-[var(--color-border)] rounded-[2px] text-[1rem]">
            <p class="font-semibold text-[var(--color-charcoal)]">Ketan Dholu, Partner</p>
            <p>Hari Hara Serenity Chemical LLP</p>
            <p>Email: <a href="mailto:Purchase@harihara.net" class="text-[var(--color-crimson)] underline">Purchase@harihara.net</a></p>
            <p>Phone: +91 9427134190</p>
          </div>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            2. Personal Data We Collect
          </h2>
          <p>
            We collect personal information exclusively when you voluntarily provide it through our website's contact and enquiry form. This includes:
          </p>
          <ul class="list-disc ps-6 space-y-1 text-[var(--color-secondary)]">
            <li>Your name</li>
            <li>Company or business affiliation (optional)</li>
            <li>Email address</li>
            <li>Phone number (optional)</li>
            <li>Enquiry type and message content</li>
          </ul>
          <p>
            In addition, your chosen interface language preference is stored locally within your own browser storage (localStorage) to maintain your reading experience across visits.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            3. Purpose and Legal Basis for Processing
          </h2>
          <p>
            We process your personal data solely to evaluate, respond to, and communicate with you regarding your commercial enquiries, partnership requests, or informational questions.
          </p>
          <p>
            In accordance with the Digital Personal Data Protection Act, 2023 (DPDP Act 2023), our legal basis for processing is your explicit, informed consent given when submitting the enquiry form.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            4. Data Processors and Service Providers
          </h2>
          <p>
            We do not sell, rent, or trade your personal data to third parties. We share data only with trusted technical service providers necessary for operating our website communications:
          </p>
          <ul class="list-disc ps-6 space-y-1 text-[var(--color-secondary)]">
            <li><strong>Web3Forms</strong>: Our form processing service, which transmits your submitted enquiry directly to our business email inbox.</li>
            <li><strong>Cloudflare</strong>: Our content delivery and web hosting infrastructure provider.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            5. Cookies and Tracking Technologies
          </h2>
          <p>
            This website does not use advertising cookies, marketing trackers, or third-party behavioral analytics scripts. All typography fonts are self-hosted directly on our origin server to ensure privacy and eliminate requests to external font services.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            6. Retention of Personal Data
          </h2>
          <p>
            We retain personal information only for as long as necessary to fulfill the purposes of responding to your enquiry and maintaining legitimate business correspondence and statutory legal records.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            7. Your Rights under the DPDP Act 2023
          </h2>
          <p>
            As a Data Principal under Indian law, you have rights regarding your personal data:
          </p>
          <ul class="list-disc ps-6 space-y-1 text-[var(--color-secondary)]">
            <li><strong>Right of Access</strong>: You may request confirmation and a summary of personal data held about you.</li>
            <li><strong>Right of Correction and Erasure</strong>: You may request the correction of inaccurate data or the deletion of data no longer required.</li>
            <li><strong>Right to Withdraw Consent</strong>: You may withdraw your consent at any time without affecting prior lawful processing.</li>
            <li><strong>Right of Grievance Redressal</strong>: You may file a grievance with our designated contact person.</li>
            <li><strong>Right to Nominate</strong>: You may nominate a representative to exercise your rights in the event of death or incapacity.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            8. Protection of Children
          </h2>
          <p>
            Our website and business operations are intended solely for commercial and professional industrial audiences. We do not knowingly solicit or collect personal data from minors.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            9. Changes to this Policy
          </h2>
          <p>
            We may update this Privacy Policy from time to time to reflect operational changes or evolving statutory requirements. The date of the latest revision is displayed at the top of this document.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            10. Grievance and Complaints
          </h2>
          <p>
            If you have an unresolved concern or grievance regarding your personal data, you may reach out to Ketan Dholu, Partner at <a href="mailto:Purchase@harihara.net" class="text-[var(--color-crimson)] underline">Purchase@harihara.net</a>. You also have the right to register a complaint with the Data Protection Board of India in accordance with applicable rules under the DPDP Act 2023.
          </p>
        </section>
      </article>

      <!-- Return link -->
      <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <a
          href={lang === 'en' ? '/' : `/${lang}/`}
          class="inline-flex items-center gap-2 text-[1rem] font-semibold text-[var(--color-crimson)] hover:text-[var(--color-maroon)] transition-colors underline decoration-2 underline-offset-4 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
        >
          <svg class="w-4 h-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
          </svg>
          <span>{lang === 'en' ? 'Back to home page' : t('not_found.home_link')}</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
