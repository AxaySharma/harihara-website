---
import { languages, getVisibleLanguages } from '../i18n/languages.config';

interface Props {
  currentLang: string;
  selectLangLabel?: string;
  class?: string;
  idPrefix?: string;
}

const {
  currentLang,
  selectLangLabel = 'Select language',
  class: className = '',
  idPrefix = 'header',
} = Astro.props;

const showDrafts = import.meta.env.SHOW_DRAFT_LANGUAGES === 'true';
const visibleLanguages = getVisibleLanguages(showDrafts);
const currentLangConfig = languages[currentLang] || languages.en;

const btnId = `${idPrefix}-lang-btn`;
const menuId = `${idPrefix}-lang-menu`;
---

<div class={`relative inline-block text-start language-switcher ${className}`} data-lang-switcher>
  <!-- 48px tall trigger with code and visible chevron, 3px focus ring -->
  <button
    id={btnId}
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls={menuId}
    aria-label={selectLangLabel}
    data-lang-btn
    class="inline-flex items-center gap-2 h-12 px-3 text-[1rem] tracking-wider uppercase font-semibold text-[var(--color-charcoal)] hover:text-[var(--color-crimson)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] border border-[var(--color-border)] hover:border-[var(--color-crimson)] transition-colors cursor-pointer rounded-[2px]"
  >
    <span class="tracking-widest">{currentLangConfig.code.toUpperCase()}</span>
    <svg
      data-lang-arrow
      class="w-4 h-4 text-[var(--color-secondary)] transition-transform duration-200"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 6l4 4 4-4" />
    </svg>
  </button>

  <div
    id={menuId}
    role="menu"
    aria-labelledby={btnId}
    data-lang-menu
    class="hidden absolute end-0 z-50 mt-1 min-w-[15rem] max-h-[75vh] overflow-y-auto border border-[var(--color-border)] bg-[var(--color-paper)] py-1.5 shadow-[0_4px_16px_rgba(0,0,0,0.08)] focus:outline-none"
  >
    {visibleLanguages.map((lang) => {
      const isSelected = lang.code === currentLang;
      const targetHref = lang.code === 'en' ? '/' : `/${lang.code}/`;
      return (
        <a
          href={targetHref}
          role="menuitem"
          lang={lang.htmlLang}
          dir={lang.direction}
          data-lang={lang.code}
          aria-current={isSelected ? 'true' : undefined}
          class={`flex items-center justify-between px-4 h-12 text-[1.0625rem] transition-colors hover:bg-[var(--color-paper-light)] focus:bg-[var(--color-paper-light)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] ${
            isSelected ? 'font-bold text-[var(--color-crimson)] bg-[var(--color-paper-light)]' : 'text-[var(--color-charcoal)]'
          }`}
        >
          <span class="font-medium">{lang.nativeName}</span>
          <span class="text-[0.875rem] text-[var(--color-secondary)] uppercase tracking-[0.1em]">{lang.name}</span>
        </a>
      );
    })}
  </div>
</div>

<script>
  function initLanguageSwitchers() {
    const switchers = document.querySelectorAll<HTMLElement>('[data-lang-switcher]');
    switchers.forEach((switcher) => {
      const button = switcher.querySelector<HTMLButtonElement>('[data-lang-btn]');
      const dropdown = switcher.querySelector<HTMLElement>('[data-lang-menu]');
      const arrow = switcher.querySelector<HTMLElement>('[data-lang-arrow]');
      if (!button || !dropdown) return;

      function toggle(open?: boolean) {
        if (!dropdown || !button) return;
        const shouldOpen = open !== undefined ? open : dropdown.classList.contains('hidden');
        if (shouldOpen) {
          dropdown.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
          if (arrow) arrow.style.transform = 'rotate(180deg)';
          const active = dropdown.querySelector<HTMLAnchorElement>('[aria-current="true"]') || dropdown.querySelector<HTMLAnchorElement>('a[role="menuitem"]');
          if (active) active.focus();
        } else {
          dropdown.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
          if (arrow) arrow.style.transform = '';
        }
      }

      button.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = button.getAttribute('aria-expanded') === 'true';
        toggle(!expanded);
      });

      document.addEventListener('click', (e) => {
        if (!switcher.contains(e.target as Node)) {
          toggle(false);
        }
      });

      const items = dropdown.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]');
      dropdown.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement;
        const idx = Array.from(items).indexOf(target as HTMLAnchorElement);
        if (e.key === 'Escape') {
          toggle(false);
          button.focus();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          items[(idx + 1) % items.length]?.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          items[(idx - 1 + items.length) % items.length]?.focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          items[0]?.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          items[items.length - 1]?.focus();
        }
      });

      items.forEach((item) => {
        item.addEventListener('click', () => {
          const selected = item.getAttribute('data-lang');
          if (selected) {
            try {
              localStorage.setItem('user_selected_lang', selected);
            } catch (err) {}
          }
        });
      });
    });
  }

  initLanguageSwitchers();
</script>
