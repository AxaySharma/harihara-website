---
import { languages, getVisibleLanguages } from '../i18n/languages.config';

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const showDrafts = import.meta.env.SHOW_DRAFT_LANGUAGES === 'true';
const visibleLanguages = getVisibleLanguages(showDrafts);
const currentLangConfig = languages[currentLang] || languages.en;
---

<div class="relative inline-block text-start language-switcher-wrapper">
  <button
    id="lang-menu-button"
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="lang-menu-dropdown"
    aria-label="Select language"
    class="inline-flex items-center gap-2 px-3 py-1.5 text-xs tracking-wider uppercase font-medium rounded border border-[var(--color-border)] bg-[var(--color-paper-light)] hover:border-[var(--color-crimson)] focus:outline-none focus:ring-2 focus:ring-[var(--color-crimson)] transition-colors duration-150 cursor-pointer"
  >
    <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-crimson)]"></span>
    <span class="font-medium text-[var(--color-charcoal)]">{currentLangConfig.nativeName}</span>
    <svg class="w-3.5 h-3.5 text-[var(--color-grey)] transition-transform duration-200" id="lang-arrow" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </button>

  <div
    id="lang-menu-dropdown"
    role="menu"
    aria-labelledby="lang-menu-button"
    class="hidden absolute end-0 z-50 mt-1 min-w-[13rem] max-h-[80vh] overflow-y-auto rounded-md shadow-lg border border-[var(--color-border)] bg-[var(--color-paper-light)] py-1 focus:outline-none"
  >
    {visibleLanguages.map((lang) => {
      const isSelected = lang.code === currentLang;
      const targetHref = lang.code === 'en' ? '/' : `/${lang.code}/`;
      return (
        <a
          href={targetHref}
          role="menuitem"
          lang={lang.htmlLang}
          dir={lang.direction}
          data-lang={lang.code}
          class={`flex items-center justify-between px-3 py-2 text-xs transition-colors hover:bg-[var(--color-paper)] focus:bg-[var(--color-paper)] focus:outline-none ${
            isSelected ? 'font-bold text-[var(--color-crimson)]' : 'text-[var(--color-charcoal)]'
          }`}
        >
          <span class="text-sm font-medium">{lang.nativeName}</span>
          <span class="text-[10px] text-[var(--color-grey)] uppercase tracking-wider">{lang.name}</span>
        </a>
      );
    })}
  </div>
</div>

<script>
  function setupLanguageSwitcher() {
    const button = document.getElementById('lang-menu-button');
    const dropdown = document.getElementById('lang-menu-dropdown');
    const arrow = document.getElementById('lang-arrow');
    if (!button || !dropdown) return;

    function toggleMenu(open?: boolean) {
      const isOpen = open !== undefined ? open : dropdown?.classList.contains('hidden');
      if (isOpen) {
        dropdown?.classList.remove('hidden');
        button?.setAttribute('aria-expanded', 'true');
        arrow?.classList.add('rotate-180');
        // focus first menu item or active item
        const activeItem = dropdown?.querySelector<HTMLAnchorElement>('[aria-current="true"]') || dropdown?.querySelector<HTMLAnchorElement>('a[role="menuitem"]');
        activeItem?.focus();
      } else {
        dropdown?.classList.add('hidden');
        button?.setAttribute('aria-expanded', 'false');
        arrow?.classList.remove('rotate-180');
      }
    }

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      toggleMenu(!isExpanded);
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !button.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    // Keyboard navigation
    const menuItems = dropdown.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]');
    dropdown.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const currentIndex = Array.from(menuItems).indexOf(target as HTMLAnchorElement);

      if (e.key === 'Escape') {
        toggleMenu(false);
        button.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIndex = (currentIndex + 1) % menuItems.length;
        menuItems[nextIndex]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prevIndex = (currentIndex - 1 + menuItems.length) % menuItems.length;
        menuItems[prevIndex]?.focus();
      } else if (e.key === 'Home') {
        e.preventDefault();
        menuItems[0]?.focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        menuItems[menuItems.length - 1]?.focus();
      }
    });

    // Save visitor's manual language choice
    menuItems.forEach((item) => {
      item.addEventListener('click', () => {
        const selectedLang = item.getAttribute('data-lang');
        if (selectedLang) {
          try {
            localStorage.setItem('user_selected_lang', selectedLang);
          } catch (e) {
            // localstorage might be unavailable
          }
        }
      });
    });
  }

  // Setup on page load
  setupLanguageSwitcher();
</script>
