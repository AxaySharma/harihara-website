---
import HeroArt from './HeroArt.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="relative overflow-hidden hero-section">
  <div class="site-container">
    <!-- Desktop 12-column grid: 7 cols text on start side, 5 cols art on end side bottom-aligned -->
    <div class="grid-12 items-end">
      <!-- Start Column: Editorial Copy & Actions (7 cols desktop) -->
      <div class="col-span-12 lg:col-span-7 flex flex-col justify-end text-start">
        <!-- Eyebrow with leading crimson rule, minimum 0.875rem, secondary color #55524F -->
        <div class="hero-load-item flex items-center gap-3 mb-6 sm:mb-8" style="--stagger: 0;">
          <span class="w-6 h-[2px] bg-[var(--color-crimson)] shrink-0" aria-hidden="true"></span>
          <span class="hero-eyebrow font-label text-[0.875rem] tracking-[0.12em] uppercase font-semibold text-[var(--color-secondary)]">
            {t('hero.eyebrow')}
          </span>
        </div>

        <!-- Headline: Newsreader, regular weight, --text-hero token, tight leading ~1.08 -->
        <h1
          class="hero-load-item font-heading font-normal text-[var(--color-charcoal)] leading-[1.08] tracking-[-0.02em] mb-6 sm:mb-8 hero-headline"
          style="--stagger: 1;"
        >
          {t('hero.headline')}
        </h1>

        <!-- Lead paragraph: --text-lg, max-width 36em, line length 60-70 characters -->
        <p
          class="hero-load-item font-body text-[var(--color-charcoal)] max-w-[36em] leading-relaxed mb-6 sm:mb-8 hero-lead"
          style="--stagger: 2;"
        >
          {t('hero.lead')}
        </p>

        <!-- Status line with thin crimson dot, minimum 0.875rem, secondary color -->
        <div
          class="hero-load-item inline-flex items-center gap-2.5 mb-8 sm:mb-10"
          style="--stagger: 3;"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-crimson)] shrink-0" aria-hidden="true"></span>
          <span class="text-[0.875rem] uppercase tracking-[0.1em] font-medium text-[var(--color-secondary)]">
            {t('hero.status')}
          </span>
        </div>

        <!-- Two Action Links: Primary button & Secondary text link -->
        <div
          class="hero-load-item flex flex-wrap items-center gap-6 sm:gap-8"
          style="--stagger: 4;"
        >
          <!-- Primary button: 56px tall, 1.0625rem semibold, padding-inline 2rem, hover #7A1230, double ring on dark/crimson -->
          <a
            href="#contact"
            class="btn-primary inline-flex items-center justify-center min-h-[3.5rem] px-6 sm:px-8 max-w-full text-center bg-[var(--color-crimson)] text-[var(--color-paper)] text-[1.0625rem] font-semibold uppercase tracking-[0.12em] rounded-[2px] transition-colors hover:bg-[var(--color-maroon)] focus:outline-none"
          >
            {t('hero.cta_primary')}
          </a>

          <!-- Secondary text link: 1.0625rem with 2px underline, mirrors in RTL -->
          <a
            href="#about"
            class="group inline-flex items-center gap-2.5 min-h-[48px] py-2 text-[1.0625rem] font-semibold text-[var(--color-charcoal)] hover:text-[var(--color-crimson)] transition-colors focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)]"
          >
            <span class="border-b-2 border-current pb-0.5">{t('hero.cta_secondary')}</span>
            <svg
              class="w-4.5 h-4.5 text-[var(--color-crimson)] transition-transform duration-200 group-hover:translate-x-1.5 rtl:group-hover:-translate-x-1.5 rtl:rotate-180"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        </div>
      </div>

      <!-- End Column: Arch Artwork with clean SVG salt pans (5 cols desktop) -->
      <div class="col-span-12 lg:col-span-5 flex flex-col items-center lg:items-end w-full mt-6 lg:mt-0">
        <div class="w-full max-w-[560px] flex flex-col">
          <HeroArt />
          <!-- Translated Caption below artwork: minimum 0.875rem in secondary color -->
          <p class="font-body text-[0.875rem] text-[var(--color-secondary)] text-start mt-4 leading-relaxed tracking-normal" data-caption="true">
            {t('hero.image_caption')}
          </p>
        </div>
      </div>
    </div>

    <!-- Ruled Facts Strip below hero block: 1 column below 640px, 2 columns on tablet, 4 on desktop -->
    <div class="facts-wrapper border-t border-[var(--color-border)]">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 facts-strip divide-y sm:divide-y-0 divide-[var(--color-border)]">
        <!-- Item 1: Location -->
        <div class="fact-col py-8 sm:py-6 sm:pe-6 lg:pe-8 flex flex-col gap-2.5">
          <span class="fact-label font-label text-[0.875rem] tracking-[0.1em] uppercase text-[var(--color-secondary)] font-medium">
            {t('facts.location_label')}
          </span>
          <span class="font-body text-[1.1875rem] text-[var(--color-charcoal)] leading-relaxed font-normal">
            {t('facts.location_value')}
          </span>
        </div>

        <!-- Item 2: Planned focus -->
        <div class="fact-col py-8 sm:py-6 sm:px-6 lg:px-8 sm:border-s sm:border-[var(--color-border)] flex flex-col gap-2.5">
          <span class="fact-label font-label text-[0.875rem] tracking-[0.1em] uppercase text-[var(--color-secondary)] font-medium">
            {t('facts.focus_label')}
          </span>
          <span class="font-body text-[1.1875rem] text-[var(--color-charcoal)] leading-relaxed font-normal">
            {t('facts.focus_value')}
          </span>
        </div>

        <!-- Item 3: Industries -->
        <div class="fact-col py-8 sm:py-6 sm:pe-6 lg:px-8 sm:border-t lg:border-t-0 sm:border-s-0 lg:border-s lg:border-[var(--color-border)] flex flex-col gap-2.5">
          <span class="fact-label font-label text-[0.875rem] tracking-[0.1em] uppercase text-[var(--color-secondary)] font-medium">
            {t('facts.industries_label')}
          </span>
          <span class="font-body text-[1.1875rem] text-[var(--color-charcoal)] leading-relaxed font-normal">
            {t('facts.industries_value')}
          </span>
        </div>

        <!-- Item 4: Status -->
        <div class="fact-col py-8 sm:py-6 sm:px-6 lg:ps-8 sm:border-t lg:border-t-0 sm:border-s sm:border-[var(--color-border)] flex flex-col gap-2.5">
          <span class="fact-label font-label text-[0.875rem] tracking-[0.1em] uppercase text-[var(--color-secondary)] font-medium">
            {t('facts.status_label')}
          </span>
          <span class="font-body text-[1.1875rem] text-[var(--color-charcoal)] leading-relaxed font-normal">
            {t('facts.status_value')}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-block-start: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    padding-block-end: var(--section-space);
  }

  @media (min-width: 1024px) {
    .hero-section {
      min-height: calc(100dvh - 5.5rem);
      min-height: calc(100vh - 5.5rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
  }

  .hero-headline {
    font-size: var(--text-hero);
  }

  .hero-lead {
    font-size: var(--text-lg);
  }

  .facts-wrapper {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }

  .fact-col {
    padding: 2rem;
  }

  @media (max-width: 640px) {
    .fact-col {
      padding-inline: 0;
      padding-block: 1.75rem;
    }
  }

  /* Load-in entrance animation: fade and rise 12px with 80ms stagger, 600ms ease-out */
  @media (prefers-reduced-motion: no-preference) {
    .hero-load-item {
      opacity: 0;
      transform: translateY(12px);
      animation: heroEntrance 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(var(--stagger, 0) * 80ms);
    }
  }

  @keyframes heroEntrance {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduced-motion guarantee */
  @media (prefers-reduced-motion: reduce) {
    .hero-load-item {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }

  /* Non-casing script typography adjustments */
  html[lang="hi"] .hero-eyebrow,
  html[lang="gu"] .hero-eyebrow,
  html[lang="zh-Hans"] .hero-eyebrow,
  html[lang="ja"] .hero-eyebrow,
  html[lang="ko"] .hero-eyebrow,
  html[lang="ar"] .hero-eyebrow {
    letter-spacing: normal;
  }

  html[lang="hi"] .fact-label,
  html[lang="gu"] .fact-label,
  html[lang="zh-Hans"] .fact-label,
  html[lang="ja"] .fact-label,
  html[lang="ko"] .fact-label,
  html[lang="ar"] .fact-label {
    letter-spacing: normal;
  }
</style>
