---
import { useTranslations } from '../i18n/utils';
import { LOCATIONS } from '../data/locations';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="location"
  class="relative py-[var(--section-space)] border-b border-[var(--color-border)] bg-[var(--color-paper)] scroll-mt-24"
  aria-labelledby="location-heading"
>
  <div class="site-container">
    <!-- Header -->
    <div class="mb-10 sm:mb-12 max-w-[44em]">
      <span class="inline-block text-[0.875rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-secondary)] mb-3">
        {t('location.label')}
      </span>
      <h2
        id="location-heading"
        class="font-heading text-[var(--text-xl)] sm:text-[var(--text-2xl)] text-[var(--color-charcoal)] mb-4"
      >
        {t('location.heading')}
      </h2>
      <p class="text-[var(--text-base)] text-[var(--color-secondary)] leading-relaxed">
        {t('location.intro')}
      </p>
    </div>

    <!-- Wide photo of salt flats / coast of Kachchh -->
    <div class="mb-12 sm:mb-16">
      <figure class="w-full max-w-[1400px] mx-auto m-0 p-0">
        <div class="image-frame relative w-full aspect-[16/9] sm:aspect-[21/9] lg:aspect-[2.8/1] overflow-hidden rounded-[2px] border border-[var(--color-border)] bg-[#F7F2E8]">
          <img
            src="/images/salt-flat-02.jpg"
            alt={t('location.photo_alt')}
            width="2400"
            height="1601"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center filter sepia-[0.10] brightness-[0.98] contrast-[1.02]"
          />
        </div>
        <figcaption class="image-caption w-full text-[0.875rem] text-[var(--color-secondary)] mt-3 text-start">
          {t('location.photo_caption')}
        </figcaption>
      </figure>
    </div>

    <!-- Three ruled columns (stack on mobile), plant first and visually largest -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 divide-y md:divide-y-0 md:divide-x divide-[var(--color-border)] rtl:md:divide-x-reverse items-start">
      {LOCATIONS.map((loc, idx) => {
        const linkUrl = loc.mapsUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.mapsQuery)}`;
        const title = t(loc.titleKey);
        return (
          <div class={`pt-8 md:pt-0 ${idx === 0 ? 'md:pe-8' : idx === 1 ? 'md:px-8' : 'md:ps-8'} flex flex-col justify-between h-full`}>
            <div>
              <div class="flex items-center gap-2 mb-3">
                {loc.isPrimary && (
                  <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-crimson)] shrink-0" aria-hidden="true" />
                )}
                <h3 class={`font-heading text-[var(--color-charcoal)] ${loc.isPrimary ? 'text-[1.375rem] sm:text-[1.625rem] font-semibold' : 'text-[1.1875rem] sm:text-[1.3125rem]'}`}>
                  {title}
                </h3>
              </div>

              <!-- Address verbatim as provided by the client -->
              <p class="text-[1rem] sm:text-[1.0625rem] text-[var(--color-secondary)] leading-relaxed mb-6">
                {loc.address}
              </p>
            </div>

            <!-- Maps link opening in new tab with rel="noopener" and translated visually hidden text -->
            <div class="pt-2">
              <a
                href={linkUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 text-[1rem] font-semibold text-[var(--color-crimson)] hover:text-[var(--color-maroon)] transition-colors underline decoration-2 underline-offset-4 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
              >
                <span>{t('location.maps_link')}</span>
                <span class="sr-only"> {t('location.opens_in_new_tab')}</span>
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
