---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const whatsappGreeting = encodeURIComponent(t('contact.whatsapp_greeting'));
const emailSubject = encodeURIComponent(t('contact.email_subject'));

const offices = [
  { name: t('location.plant_title'), id: 'location' },
  { name: t('location.corp_title'), id: 'location' },
  { name: t('location.reg_title'), id: 'location' },
];
---

<section
  id="contact"
  class="relative py-[var(--section-space)] border-b border-[var(--color-border)] bg-[var(--color-paper)] scroll-mt-24"
  aria-labelledby="contact-heading"
>
  <div class="site-container">
    <!-- Header -->
    <div class="mb-12 sm:mb-16 max-w-[42em]">
      <span class="inline-block text-[0.875rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-secondary)] mb-3">
        {t('contact.label')}
      </span>
      <h2
        id="contact-heading"
        class="font-heading section-heading text-[var(--color-charcoal)] mb-3"
      >
        {t('contact.heading')}
      </h2>
      <p class="text-[var(--text-base)] text-[var(--color-secondary)] leading-relaxed">
        {t('contact.line')}
      </p>
    </div>

    <!-- Editorial Layout: Direct Contact Actions (Start) vs Office Links Panel (End) -->
    <div class="grid-12 items-start">
      <!-- Start Side: Large Serif Email & 56px Ruled Phone/WhatsApp Rows -->
      <div class="col-span-12 lg:col-span-7 space-y-8">
        <!-- Large Serif Email Link (Scales down gracefully without overflow at 320px) -->
        <div class="border-b border-[var(--color-border)] pb-8">
          <span class="block text-[0.875rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-secondary)] mb-3">
            {t('contact.email_label')}
          </span>
          <a
            href={`mailto:Purchase@harihara.net?subject=${emailSubject}`}
            class="font-heading text-[1.375rem] sm:text-[1.875rem] lg:text-[2.125rem] text-[var(--color-charcoal)] hover:text-[var(--color-crimson)] transition-colors underline decoration-2 underline-offset-8 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px] block break-all sm:break-normal [overflow-wrap:anywhere]"
          >
            Purchase@harihara.net
          </a>
        </div>

        <!-- Phone and WhatsApp 56px tall ruled rows -->
        <div class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
          <!-- Phone Row -->
          <a
            href="tel:+919427134190"
            class="min-h-[3.5rem] py-3.5 flex items-center justify-between group focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
          >
            <div class="flex items-center gap-4">
              <span class="text-[0.875rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-secondary)] w-28 shrink-0">
                {t('contact.phone_label')}
              </span>
              <span class="font-heading text-[1.25rem] sm:text-[1.375rem] text-[var(--color-charcoal)] group-hover:text-[var(--color-crimson)] transition-colors">
                9427134190
              </span>
            </div>
            <svg
              class="w-5 h-5 text-[var(--color-secondary)] group-hover:text-[var(--color-crimson)] group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180 transition-all shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>

          <!-- WhatsApp Row -->
          <a
            href={`https://wa.me/919427134190?text=${whatsappGreeting}`}
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[3.5rem] py-3.5 flex items-center justify-between group focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
          >
            <div class="flex items-center gap-4">
              <span class="text-[0.875rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-secondary)] w-28 shrink-0">
                {t('contact.whatsapp_label')}
              </span>
              <span class="font-heading text-[1.25rem] sm:text-[1.375rem] text-[var(--color-charcoal)] group-hover:text-[var(--color-crimson)] transition-colors">
                9427134190
              </span>
            </div>
            <svg
              class="w-5 h-5 text-[var(--color-secondary)] group-hover:text-[var(--color-crimson)] group-hover:translate-x-1 rtl:group-hover:-translate-x-1 rtl:rotate-180 transition-all shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <!-- Enquiries Note -->
        <div class="pt-2">
          <p class="text-[1rem] sm:text-[1.0625rem] text-[var(--color-secondary)] italic leading-relaxed">
            {t('contact.enquiries_note')}
          </p>
        </div>
      </div>

      <!-- End Side: Quiet Arch-Shaped Panel Repeating Office Names linking to #location -->
      <div class="col-span-12 lg:col-span-5 flex flex-col items-center lg:items-end">
        <div class="w-full max-w-[400px] p-8 sm:p-10 arch-frame rounded-b-[2px] border border-[var(--color-border)] bg-[var(--color-paper-light)] shadow-[0_0_0_1px_rgba(28,28,28,0.04)] text-center flex flex-col items-center">
          <!-- Arch Motif Accent -->
          <div class="w-10 h-10 mb-6 flex items-center justify-center text-[var(--color-crimson)]" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" class="w-8 h-8">
              <path d="M8 32V20C8 13.3726 13.3726 8 20 8C26.6274 8 32 13.3726 32 20V32" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </div>

          <h3 class="text-[0.875rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)] mb-6">
            {t('contact.locations_heading')}
          </h3>

          <ul class="space-y-4 w-full divide-y divide-[var(--color-border)]">
            {offices.map((office, idx) => (
              <li class={idx > 0 ? "pt-4" : ""}>
                <a
                  href={`#${office.id}`}
                  class="group inline-flex items-center gap-2 font-heading text-[1.125rem] text-[var(--color-charcoal)] hover:text-[var(--color-crimson)] transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--color-crimson)] rounded-[2px]"
                >
                  <span>{office.name}</span>
                  <svg
                    class="w-4 h-4 text-[var(--color-secondary)] group-hover:text-[var(--color-crimson)] transition-colors"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <line x1="7" y1="7" x2="17" y2="17" />
                    <polyline points="17 7 17 17 7 17" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
