---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
if (!web3formsKey && import.meta.env.PROD) {
  console.warn('⚠️ WARNING: PUBLIC_WEB3FORMS_KEY is missing from environment. Form will fallback to mailto.');
}
---

<section
  id="contact"
  class="relative py-[var(--section-space)] border-b border-[var(--color-border)] bg-[var(--color-paper-light)] scroll-mt-24"
  aria-labelledby="contact-heading"
>
  <div class="max-w-[78rem] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-12 sm:mb-16 max-w-[36em]">
      <span class="inline-block text-[0.875rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-secondary)] mb-3">
        {t('contact.label')}
      </span>
      <h2
        id="contact-heading"
        class="font-heading text-[var(--text-xl)] sm:text-[var(--text-2xl)] text-[var(--color-charcoal)] mb-3"
      >
        {t('contact.heading')}
      </h2>
      <p class="text-[var(--text-base)] text-[var(--color-secondary)] leading-relaxed">
        {t('contact.line')}
      </p>
    </div>

    <!-- Two-column editorial layout: Direct Details (Start) vs Enquiry Form (End) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Start Side: Contact Details & Enquiries Note -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Direct Email -->
        <div class="border-b border-[var(--color-border)] pb-6">
          <span class="block text-[0.875rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-secondary)] mb-2">
            {t('contact.email_label')}
          </span>
          <a
            href="mailto:Purchase@harihara.net"
            class="font-heading text-[1.25rem] sm:text-[1.5rem] text-[var(--color-charcoal)] hover:text-[var(--color-crimson)] transition-colors underline decoration-1 underline-offset-4 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
          >
            Purchase@harihara.net
          </a>
        </div>

        <!-- Phone & WhatsApp -->
        <div class="border-b border-[var(--color-border)] pb-6">
          <span class="block text-[0.875rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-secondary)] mb-2">
            {t('contact.phone_label')}
          </span>
          <div class="flex flex-wrap items-center gap-4 sm:gap-6">
            <a
              href="tel:9427134190"
              class="font-heading text-[1.25rem] sm:text-[1.5rem] text-[var(--color-charcoal)] hover:text-[var(--color-crimson)] transition-colors focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
            >
              9427134190
            </a>
            <span class="text-[var(--color-border)]" aria-hidden="true">|</span>
            <a
              href="https://wa.me/919427134190"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[1rem] font-semibold text-[var(--color-crimson)] hover:text-[var(--color-maroon)] transition-colors underline decoration-1 underline-offset-4 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
            >
              <span>WhatsApp</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Enquiries Attended By Note -->
        <div class="bg-[var(--color-paper)] p-6 border border-[var(--color-border)] rounded-[2px]">
          <p class="text-[1rem] sm:text-[1.0625rem] text-[var(--color-charcoal)] leading-relaxed">
            {t('contact.enquiries_note')}
          </p>
        </div>
      </div>

      <!-- End Side: Enquiry Form -->
      <div class="lg:col-span-7 bg-[var(--color-paper)] p-6 sm:p-10 border border-[var(--color-border)] rounded-[2px]">
        <form
          id="enquiry-form"
          data-lang={lang}
          data-key={web3formsKey}
          novalidate
          class="space-y-6"
        >
          <!-- Hidden Web3Forms & Anti-spam / Language fields -->
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="New enquiry from harihara.net" />
          <input type="hidden" name="from_name" value="Hari Hara Serenity Web Form" />
          <input type="hidden" name="page_language" value={lang} />
          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Form Status Feedback Box (aria-live) -->
          <div
            id="form-feedback"
            class="hidden p-4 rounded-[2px] text-[1rem]"
            role="status"
            aria-live="polite"
          />

          <!-- Name field (required) -->
          <div>
            <label for="form-name" class="block text-[1rem] font-medium text-[var(--color-charcoal)] mb-2">
              {t('contact.form.name_label')} <span class="text-[var(--color-crimson)]" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="form-name"
              name="name"
              required
              class="w-full h-14 px-4 text-[1.125rem] bg-[var(--color-paper-light)] border border-[var(--color-border)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] focus:border-[var(--color-crimson)] transition-colors rounded-[2px] text-[var(--color-charcoal)]"
            />
            <p id="err-name" class="hidden mt-1.5 text-[0.875rem] text-[var(--color-crimson)] font-medium" />
          </div>

          <!-- Company field -->
          <div>
            <label for="form-company" class="block text-[1rem] font-medium text-[var(--color-charcoal)] mb-2">
              {t('contact.form.company_label')}
            </label>
            <input
              type="text"
              id="form-company"
              name="company"
              class="w-full h-14 px-4 text-[1.125rem] bg-[var(--color-paper-light)] border border-[var(--color-border)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] focus:border-[var(--color-crimson)] transition-colors rounded-[2px] text-[var(--color-charcoal)]"
            />
          </div>

          <!-- Email & Phone Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Email field (required) -->
            <div>
              <label for="form-email" class="block text-[1rem] font-medium text-[var(--color-charcoal)] mb-2">
                {t('contact.form.email_label')} <span class="text-[var(--color-crimson)]" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="form-email"
                name="email"
                required
                class="w-full h-14 px-4 text-[1.125rem] bg-[var(--color-paper-light)] border border-[var(--color-border)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] focus:border-[var(--color-crimson)] transition-colors rounded-[2px] text-[var(--color-charcoal)]"
              />
              <p id="err-email" class="hidden mt-1.5 text-[0.875rem] text-[var(--color-crimson)] font-medium" />
            </div>

            <!-- Phone field -->
            <div>
              <label for="form-phone" class="block text-[1rem] font-medium text-[var(--color-charcoal)] mb-2">
                {t('contact.form.phone_label')}
              </label>
              <input
                type="tel"
                id="form-phone"
                name="phone"
                class="w-full h-14 px-4 text-[1.125rem] bg-[var(--color-paper-light)] border border-[var(--color-border)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] focus:border-[var(--color-crimson)] transition-colors rounded-[2px] text-[var(--color-charcoal)]"
              />
            </div>
          </div>

          <!-- Enquiry Type Select -->
          <div>
            <label for="form-type" class="block text-[1rem] font-medium text-[var(--color-charcoal)] mb-2">
              {t('contact.form.type_label')}
            </label>
            <div class="relative">
              <select
                id="form-type"
                name="enquiry_type"
                class="w-full h-14 px-4 text-[1.125rem] bg-[var(--color-paper-light)] border border-[var(--color-border)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] focus:border-[var(--color-crimson)] transition-colors rounded-[2px] text-[var(--color-charcoal)] appearance-none cursor-pointer"
              >
                <option value="product">{t('contact.form.type_options.product')}</option>
                <option value="partnership">{t('contact.form.type_options.partnership')}</option>
                <option value="other">{t('contact.form.type_options.other')}</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center px-4 text-[var(--color-charcoal)]" aria-hidden="true">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Message Field (required) -->
          <div>
            <label for="form-message" class="block text-[1rem] font-medium text-[var(--color-charcoal)] mb-2">
              {t('contact.form.message_label')} <span class="text-[var(--color-crimson)]" aria-hidden="true">*</span>
            </label>
            <textarea
              id="form-message"
              name="message"
              rows="4"
              required
              class="w-full p-4 text-[1.125rem] bg-[var(--color-paper-light)] border border-[var(--color-border)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] focus:border-[var(--color-crimson)] transition-colors rounded-[2px] text-[var(--color-charcoal)]"
            />
            <p id="err-message" class="hidden mt-1.5 text-[0.875rem] text-[var(--color-crimson)] font-medium" />
          </div>

          <!-- Consent Checkbox (required) -->
          <div class="pt-2">
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="form-consent"
                name="consent"
                required
                class="mt-1 h-5 w-5 rounded-[2px] border border-[var(--color-border)] text-[var(--color-crimson)] focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] cursor-pointer"
              />
              <label for="form-consent" class="text-[0.9375rem] text-[var(--color-secondary)] leading-relaxed cursor-pointer">
                {t('contact.form.consent_label')}{' '}
                <a
                  href={lang === 'en' ? '/privacy-policy/' : `/${lang}/privacy-policy/`}
                  class="text-[var(--color-crimson)] underline decoration-1 underline-offset-2 hover:text-[var(--color-maroon)] focus:outline-none focus:ring-2 focus:ring-[var(--color-crimson)]"
                  target="_blank"
                >
                  {t('contact.form.consent_privacy_link')}
                </a>
              </label>
            </div>
            <p id="err-consent" class="hidden mt-1.5 text-[0.875rem] text-[var(--color-crimson)] font-medium" />
          </div>

          <!-- Submit Button: 56px tall, 1.0625rem semibold -->
          <div class="pt-4">
            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full sm:w-auto min-h-[3.5rem] px-8 text-center bg-[var(--color-crimson)] text-[var(--color-paper)] text-[1.0625rem] font-semibold uppercase tracking-[0.12em] rounded-[2px] transition-colors hover:bg-[var(--color-maroon)] cursor-pointer focus:outline-none focus:ring-3 focus:ring-[var(--color-charcoal)]"
            >
              <span id="btn-text">{t('contact.form.submit_btn')}</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Form validation, preselection & submit handling script -->
<script is:inline define:vars={{
  nameReq: t('contact.form.validation.name_required'),
  emailReq: t('contact.form.validation.email_required'),
  emailInv: t('contact.form.validation.email_invalid'),
  msgReq: t('contact.form.validation.message_required'),
  consentReq: t('contact.form.validation.consent_required'),
  submittingText: t('contact.form.submitting_btn'),
  submitText: t('contact.form.submit_btn'),
  successMsg: t('contact.form.success_message'),
  errorMsg: t('contact.form.error_message')
}}>
  (function() {
    const form = document.getElementById('enquiry-form');
    if (!form) return;

    const selectEl = document.getElementById('form-type');
    const feedbackEl = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');

    const nameInput = document.getElementById('form-name');
    const emailInput = document.getElementById('form-email');
    const msgInput = document.getElementById('form-message');
    const consentInput = document.getElementById('form-consent');

    const errName = document.getElementById('err-name');
    const errEmail = document.getElementById('err-email');
    const errMessage = document.getElementById('err-message');
    const errConsent = document.getElementById('err-consent');

    // Handle ?interest= parameter on load and on hashchange
    function applyInterest() {
      const url = new URL(window.location.href);
      let interest = url.searchParams.get('interest');
      if (!interest && window.location.hash.includes('?interest=')) {
        interest = window.location.hash.split('?interest=')[1];
      }
      if (interest && selectEl) {
        if (interest.includes('product')) selectEl.value = 'product';
        else if (interest.includes('partnership')) selectEl.value = 'partnership';
        else if (interest.includes('other')) selectEl.value = 'other';
      }
    }
    applyInterest();
    window.addEventListener('hashchange', applyInterest);

    // Also support clicking .enquire-trigger links dynamically
    document.querySelectorAll('.enquire-trigger').forEach(link => {
      link.addEventListener('click', () => {
        if (selectEl) selectEl.value = 'product';
      });
    });

    function isValidEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      // Reset errors
      let hasError = false;
      [errName, errEmail, errMessage, errConsent].forEach(el => {
        el.classList.add('hidden');
        el.textContent = '';
      });

      if (!nameInput.value.trim()) {
        errName.textContent = nameReq;
        errName.classList.remove('hidden');
        hasError = true;
      }

      if (!emailInput.value.trim()) {
        errEmail.textContent = emailReq;
        errEmail.classList.remove('hidden');
        hasError = true;
      } else if (!isValidEmail(emailInput.value.trim())) {
        errEmail.textContent = emailInv;
        errEmail.classList.remove('hidden');
        hasError = true;
      }

      if (!msgInput.value.trim()) {
        errMessage.textContent = msgReq;
        errMessage.classList.remove('hidden');
        hasError = true;
      }

      if (!consentInput.checked) {
        errConsent.textContent = consentReq;
        errConsent.classList.remove('hidden');
        hasError = true;
      }

      if (hasError) return;

      const accessKey = form.getAttribute('data-key');
      const formData = new FormData(form);

      // If key is missing or dummy, fallback gracefully to pre-filled mailto
      if (!accessKey || accessKey === 'your_web3forms_access_key_here') {
        const mailSubject = encodeURIComponent('New enquiry from harihara.net: ' + selectEl.value);
        const mailBody = encodeURIComponent(
          'Name: ' + nameInput.value + '\n' +
          'Company: ' + (document.getElementById('form-company')?.value || '') + '\n' +
          'Phone: ' + (document.getElementById('form-phone')?.value || '') + '\n' +
          'Enquiry Type: ' + selectEl.value + '\n\n' +
          'Message:\n' + msgInput.value
        );
        window.location.href = `mailto:Purchase@harihara.net?subject=${mailSubject}&body=${mailBody}`;
        feedbackEl.className = 'p-4 rounded-[2px] text-[1rem] bg-emerald-50 text-emerald-800 border border-emerald-200 mb-6';
        feedbackEl.textContent = successMsg;
        feedbackEl.classList.remove('hidden');
        return;
      }

      // Live fetch submit
      submitBtn.disabled = true;
      btnText.textContent = submittingText;
      feedbackEl.classList.add('hidden');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const result = await response.json();

        if (response.status === 200 && result.success) {
          feedbackEl.className = 'p-4 rounded-[2px] text-[1rem] bg-emerald-50 text-emerald-800 border border-emerald-200 mb-6';
          feedbackEl.textContent = successMsg;
          feedbackEl.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error(result.message || 'Error submitting');
        }
      } catch (err) {
        feedbackEl.className = 'p-4 rounded-[2px] text-[1rem] bg-rose-50 text-rose-900 border border-rose-200 mb-6';
        feedbackEl.innerHTML = `${errorMsg} <br><a href="mailto:Purchase@harihara.net" class="underline font-semibold">Purchase@harihara.net</a>`;
        feedbackEl.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = submitText;
      }
    });
  })();
</script>
