---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  {
    num: '01',
    title: t('process.steps.0.title'),
    desc: t('process.steps.0.desc'),
    extra: t('process.steps.0.extra'),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-[var(--color-charcoal)]" aria-hidden="true"><rect x="6" y="16" width="36" height="24" rx="2" stroke="currentColor"/><path d="M6 24c6 0 6 3 12 3s6-3 12-3 6 3 12 3" stroke="var(--color-crimson)"/><path d="M6 31c6 0 6 2 12 2s6-2 12-2 6 2 12 2"/><circle cx="24" cy="10" r="3" stroke="var(--color-crimson)"/></svg>`
  },
  {
    num: '02',
    title: t('process.steps.1.title'),
    desc: t('process.steps.1.desc'),
    extra: t('process.steps.1.extra'),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-[var(--color-charcoal)]" aria-hidden="true"><path d="M12 10h24v28a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4V10z"/><line x1="16" y1="6" x2="32" y2="6"/><line x1="24" y1="6" x2="24" y2="10"/><path d="M24 28V18m0 0l-4 4m4-4l4 4" stroke="var(--color-crimson)"/><circle cx="24" cy="34" r="1.5" fill="var(--color-crimson)"/></svg>`
  },
  {
    num: '03',
    title: t('process.steps.2.title'),
    desc: t('process.steps.2.desc'),
    extra: t('process.steps.2.extra'),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-[var(--color-charcoal)]" aria-hidden="true"><path d="M20 6h8v8l8 18a4 4 0 0 1-3.5 6H15.5A4 4 0 0 1 12 32l8-18V6z"/><line x1="18" y1="6" x2="30" y2="6"/><path d="M17 26h14" stroke="var(--color-crimson)"/><circle cx="24" cy="33" r="2" fill="var(--color-crimson)"/></svg>`
  },
  {
    num: '04',
    title: t('process.steps.3.title'),
    desc: t('process.steps.3.desc'),
    extra: t('process.steps.3.extra'),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-[var(--color-charcoal)]" aria-hidden="true"><path d="M24 8c-7 9-11 15-11 21a11 11 0 0 0 22 0c0-6-4-12-11-21z"/><circle cx="24" cy="28" r="3" stroke="var(--color-crimson)"/><path d="M24 35v-2" stroke="var(--color-crimson)"/></svg>`
  },
];
---

<section
  id="process"
  class="relative py-[var(--section-space)] border-b border-[var(--color-border)] bg-[var(--color-paper-light)] scroll-mt-24"
  aria-labelledby="process-heading"
>
  <div class="max-w-[78rem] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-12 sm:mb-16 max-w-[36em]">
      <span class="inline-block text-[0.875rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-secondary)] mb-3">
        {t('process.label')}
      </span>
      <h2
        id="process-heading"
        class="font-heading text-[var(--text-xl)] sm:text-[var(--text-2xl)] text-[var(--color-charcoal)] mb-4"
      >
        {t('process.heading')}
      </h2>
      <p class="text-[var(--text-base)] text-[var(--color-secondary)] leading-relaxed">
        {t('process.intro')}
      </p>
    </div>

    <!-- 4 Numbered Steps Sequence with subtle connecting line -->
    <div class="relative">
      <!-- Horizontal Connecting Rule on Desktop (hidden on mobile) -->
      <div
        class="hidden lg:block absolute top-[2.25rem] inset-x-8 h-[1px] bg-[var(--color-border)] pointer-events-none"
        aria-hidden="true"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-8">
        {steps.map((step) => (
          <div class="relative flex flex-col pt-4 lg:pt-0">
            <!-- Large Serif Numeral with paper-light background badge & SVG drawing -->
            <div class="mb-5 flex items-center justify-between pe-4">
              <span class="font-heading text-[2.25rem] sm:text-[2.75rem] text-[var(--color-crimson)] leading-none pe-4 bg-[var(--color-paper-light)]">
                {step.num}
              </span>
              <div class="p-2 bg-[var(--color-paper)] border border-[var(--color-border)] rounded-[2px]" set:html={step.svg} />
            </div>

            <!-- Title -->
            <h3 class="font-heading text-[1.25rem] sm:text-[1.375rem] text-[var(--color-charcoal)] mb-2">
              {step.title}
            </h3>

            <!-- Description -->
            <p class="text-[1rem] sm:text-[1.0625rem] text-[var(--color-charcoal)] leading-relaxed mb-2">
              {step.desc}
            </p>

            <!-- General background extra sentence -->
            <p class="text-[0.9375rem] sm:text-[1rem] text-[var(--color-secondary)] leading-relaxed">
              {step.extra}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Closing development note under the steps -->
    <div class="mt-12 sm:mt-16 pt-8 border-t border-[var(--color-border)]">
      <p class="text-[0.9375rem] sm:text-[1rem] text-[var(--color-secondary)] italic">
        {t('process.closing_note')}
      </p>
    </div>
  </div>
</section>
