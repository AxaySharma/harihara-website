---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import imageCredits from '../data/image-credits.json';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('legal.image_credits_title')}
  description={t('legal.image_credits_description')}
>
  <div class="py-[var(--section-space)] bg-[var(--color-paper)]">
    <div class="max-w-[76ch] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Non-English convenience notice if applicable -->
      {lang !== 'en' && (
        <div class="mb-8 p-4 bg-[var(--color-paper-light)] border border-[var(--color-border)] rounded-[2px] text-[0.875rem] text-[var(--color-secondary)]">
          <p>{t('legal.official_version_notice')}</p>
        </div>
      )}

      <!-- Header -->
      <header class="mb-10 pb-6 border-b border-[var(--color-border)]">
        <h1 class="font-heading text-[var(--text-xl)] sm:text-[var(--text-2xl)] text-[var(--color-charcoal)] mb-3">
          {t('legal.image_credits_title')}
        </h1>
        <p class="text-[0.875rem] font-medium text-[var(--color-secondary)]">
          {t('legal.last_updated')} &bull; {t('site_name')}
        </p>
      </header>

      <!-- Binding English content with lang="en" for screen readers -->
      <article lang="en" class="space-y-8 text-[var(--text-base)] text-[var(--color-charcoal)] leading-relaxed">
        <section class="space-y-4">
          <p>
            All photographs reproduced on this website are <strong>representative images</strong> obtained from open, verified free-licence photography repositories (including Unsplash and Wikimedia Commons).
          </p>
          <div class="bg-[var(--color-paper-light)] p-5 border border-[var(--color-border)] rounded-[2px] text-[1rem] space-y-2">
            <p class="font-semibold text-[var(--color-charcoal)]">Licensing & Editorial Standards:</p>
            <ul class="list-disc ps-5 space-y-1 text-[var(--color-secondary)]">
              <li>No photograph depicts the proprietary plant, personnel, laboratory, or operations of Hari Hara Serenity Chemical LLP.</li>
              <li>No identifiable individuals, faces, commercial trademarks, or third-party corporate logos appear in any imagery.</li>
              <li>All images are published under the Unsplash Licence or Creative Commons Attribution (CC BY) licences.</li>
            </ul>
          </div>
        </section>

        <!-- Detailed Image Credits List -->
        <section class="space-y-6 pt-4 border-t border-[var(--color-border)]">
          <h2 class="font-heading text-[1.375rem] sm:text-[1.5rem] text-[var(--color-charcoal)]">
            Verified Image Attributions
          </h2>

          <div class="space-y-6 divide-y divide-[var(--color-border)]">
            {imageCredits.map((item) => (
              <div class="pt-6 first:pt-0 space-y-2">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-heading text-[1.125rem] sm:text-[1.25rem] text-[var(--color-charcoal)] font-semibold">
                    {item.slot}
                  </h3>
                  <span class="text-[0.875rem] text-[var(--color-crimson)] font-medium">
                    {item.license_name}
                  </span>
                </div>
                <p class="text-[0.9375rem] text-[var(--color-secondary)]">
                  {item.description}
                </p>
                <div class="text-[0.875rem] text-[var(--color-secondary)] flex flex-wrap gap-x-4 gap-y-1 pt-1">
                  <span>
                    Photographer / Author:{' '}
                    <a
                      href={item.author_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-charcoal)] underline hover:text-[var(--color-crimson)]"
                    >
                      {item.author}
                    </a>
                  </span>
                  <span>&bull;</span>
                  <span>
                    Source:{' '}
                    <a
                      href={item.source_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-charcoal)] underline hover:text-[var(--color-crimson)]"
                    >
                      {item.source_site}
                    </a>
                  </span>
                  <span>&bull;</span>
                  <span>
                    Licence Terms:{' '}
                    <a
                      href={item.license_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-charcoal)] underline hover:text-[var(--color-crimson)]"
                    >
                      View Licence
                    </a>
                  </span>
                </div>
              </div>
            ))}
          </div>
        </section>
      </article>

      <!-- Return link -->
      <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <a
          href={lang === 'en' ? '/' : `/${lang}/`}
          class="inline-flex items-center gap-2 text-[1rem] font-semibold text-[var(--color-crimson)] hover:text-[var(--color-maroon)] transition-colors underline decoration-2 underline-offset-4 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
        >
          <svg class="w-4 h-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
          </svg>
          <span>{lang === 'en' ? 'Back to home page' : t('not_found.home_link')}</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
