---
import { SHOW_LOGO_TM } from '../config';

interface Props {
  variant?: 'full' | 'symbol' | 'wordmark';
  light?: boolean;
  showTM?: boolean;
  class?: string;
  width?: number;
  height?: number;
  alt?: string;
}

const {
  variant = 'full',
  light = false,
  showTM = SHOW_LOGO_TM,
  class: className = '',
  width,
  height,
  alt = 'Hari Hara Serenity Chemical LLP',
} = Astro.props;

// Determine vector SVG source and dimensions based on variant
let src = '/brand/logo-full.svg';
let defaultWidth = 260;
let defaultHeight = 72;

if (variant === 'symbol') {
  src = '/brand/logo-symbol.svg';
  defaultWidth = 56;
  defaultHeight = 60;
} else if (variant === 'wordmark') {
  src = '/brand/logo-wordmark.svg';
  defaultWidth = 210;
  defaultHeight = 45;
} else if (variant === 'full') {
  src = light ? '/brand/logo-full-light.svg' : '/brand/logo-full.svg';
  defaultWidth = 260;
  defaultHeight = 72;
}

const finalWidth = width || defaultWidth;
const finalHeight = height || defaultHeight;
const tmColor = light ? '#B9B9B9' : '#7A7A7A';
---

<div class={`inline-flex items-center relative ${className}`}>
  <img
    src={src}
    alt={alt}
    width={finalWidth}
    height={finalHeight}
    class="inline-block object-contain"
    loading="eager"
    decoding="async"
  />

  {showTM && variant === 'symbol' && (
    <span
      class="absolute top-0 end-0 font-sans font-bold leading-none select-none text-[9px] translate-x-1.5 -translate-y-0.5"
      style={`color: ${tmColor};`}
      aria-hidden="true"
    >
      ™
    </span>
  )}

  {showTM && (variant === 'full' || variant === 'wordmark') && (
    <span
      class="font-sans font-bold leading-none select-none text-[10px] self-start mt-1 ms-0.5"
      style={`color: ${tmColor};`}
      aria-hidden="true"
    >
      ™
    </span>
  )}
</div>
