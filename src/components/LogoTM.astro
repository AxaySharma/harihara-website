---
interface Props {
  x?: number;
  y?: number;
  color?: string;
  size?: number;
  class?: string;
}

const {
  color = '#7A7A7A',
  size = 12,
  class: className = '',
} = Astro.props;
---

<span
  class={`inline-block font-sans font-bold leading-none select-none ${className}`}
  style={`font-size: ${size}px; color: ${color}; transform: translateY(-0.4em);`}
  aria-hidden="true"
>
  ™
</span>
