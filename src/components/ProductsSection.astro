---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = [
  {
    num: '01',
    title: t('products.items.0.title'),
    desc: t('products.items.0.desc'),
    type: 'product',
  },
  {
    num: '02',
    title: t('products.items.1.title'),
    desc: t('products.items.1.desc'),
    type: 'product',
  },
];
---

<section
  id="products"
  class="relative py-[var(--section-space)] border-b border-[var(--color-border)] bg-[var(--color-paper)] scroll-mt-24"
  aria-labelledby="products-heading"
>
  <div class="max-w-[78rem] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-12 sm:mb-16">
      <span class="inline-block text-[0.875rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-secondary)] mb-3">
        {t('products.label')}
      </span>
      <h2
        id="products-heading"
        class="font-heading text-[var(--text-xl)] sm:text-[var(--text-2xl)] text-[var(--color-charcoal)]"
      >
        {t('products.heading')}
      </h2>
    </div>

    <!-- Two large editorial rows separated by rules (not cards) -->
    <div class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
      {products.map((item) => (
        <div class="py-8 sm:py-12 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start">
          <!-- Numeral & Planned Tag -->
          <div class="lg:col-span-2 flex items-baseline gap-4 lg:flex-col lg:gap-2">
            <span class="font-heading text-[2.25rem] sm:text-[2.75rem] text-[var(--color-crimson)] leading-none">
              {item.num}
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-[0.875rem] font-medium tracking-wide uppercase bg-[var(--color-paper-light)] border border-[var(--color-border)] text-[var(--color-secondary)]">
              {t('products.status_tag')}
            </span>
          </div>

          <!-- Title & Descriptor -->
          <div class="lg:col-span-7 space-y-2">
            <h3 class="font-heading text-[1.5rem] sm:text-[1.75rem] text-[var(--color-charcoal)]">
              {item.title}
            </h3>
            <p class="text-[var(--text-base)] text-[var(--color-secondary)] leading-relaxed max-w-[42em]">
              {item.desc}
            </p>
          </div>

          <!-- Enquire Link with query parameter preselection -->
          <div class="lg:col-span-3 flex lg:justify-end items-center pt-2 lg:pt-0">
            <a
              href={`#contact?interest=${item.type}`}
              data-enquiry-type={item.type}
              class="enquire-trigger inline-flex items-center gap-2 text-[1.0625rem] font-semibold text-[var(--color-crimson)] hover:text-[var(--color-maroon)] transition-colors underline decoration-2 underline-offset-4 focus:outline-none focus:ring-3 focus:ring-[var(--color-crimson)] rounded-[2px]"
            >
              <span>{t('products.enquire_link')}</span>
              <svg
                class="w-4 h-4 rtl:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Under the rows -->
    <div class="mt-8 pt-4">
      <p class="text-[1rem] sm:text-[1.0625rem] text-[var(--color-secondary)]">
        {t('products.footer_note')}
      </p>
    </div>
  </div>
</section>
