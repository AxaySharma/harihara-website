---
import ImageCreditsContent from '../../../components/ImageCreditsContent.astro';
import { languages } from '../../../i18n/languages.config';

export function getStaticPaths() {
  const nonDefaultLangs = Object.keys(languages).filter((l) => l !== 'en');
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'en' } = Astro.params;
---

<ImageCreditsContent lang={lang} />
