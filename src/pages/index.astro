---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const lang = 'en';
const isDev = import.meta.env.DEV;

// Temporary stub section targets for navigation testing during development
const stubs = [
  { id: 'about', label: 'About (Planned Section Stub)' },
  { id: 'process', label: 'Process (Planned Section Stub)' },
  { id: 'products', label: 'Products (Planned Section Stub)' },
  { id: 'industries', label: 'Industries (Planned Section Stub)' },
  { id: 'location', label: 'Plant (Planned Section Stub)' },
  { id: 'contact', label: 'Contact (Planned Section Stub)' },
];
---

<BaseLayout lang={lang}>
  <!-- Hero Section -->
  <Hero lang={lang} />

  <!-- DEV-only stubs for anchor targets -->
  {isDev && (
    <div class="dev-stubs-container">
      {stubs.map((stub) => (
        <section
          id={stub.id}
          class="scroll-mt-24 border-t border-dashed border-[var(--color-border)] py-16 px-4 text-center bg-[var(--color-paper-light)]/40"
        >
          <div class="max-w-[78rem] mx-auto">
            <span class="inline-block px-2.5 py-1 text-[10px] uppercase font-label tracking-widest text-[var(--color-grey)] border border-[var(--color-border)]">
              DEV Stub: #{stub.id}
            </span>
            <p class="font-heading text-lg text-[var(--color-charcoal)]/60 mt-2">
              {stub.label}
            </p>
          </div>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
