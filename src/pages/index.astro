---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const lang = 'en';

const navTargetSections = [
  'about',
  'process',
  'products',
  'industries',
  'location',
  'contact',
];
---

<BaseLayout lang={lang}>
  <!-- Hero Section -->
  <Hero lang={lang} />

  <!-- Anchor target marker containers for header navigation targets -->
  <div class="nav-targets" aria-hidden="true">
    {navTargetSections.map((id) => (
      <div id={id} class="scroll-mt-24 pointer-events-none" />
    ))}
  </div>
</BaseLayout>
