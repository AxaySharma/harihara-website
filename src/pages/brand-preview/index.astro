---
import '../../styles/global.css';

// Brand Preview page - Quality inspection dashboard (noindex, unlinked)
// Strict numeric verification (IoU, CIE76 Delta E, gradient direction) and registration check against original JPG.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Brand Reconstruction & Quantitative Quality Inspection | Hari Hara Serenity</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-100 font-sans p-6 md:p-12 space-y-16 text-gray-900">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- HEADER -->
      <div class="border-b border-gray-300 pb-6">
        <div class="inline-block px-3 py-1 mb-2 text-xs uppercase font-mono tracking-widest text-emerald-800 bg-emerald-100 rounded">
          Internal Inspection Tool — Quantitative Vector &amp; Colour Verification
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mt-2">Brand Rebuild Quality &amp; Quantitative Verification</h1>
        <p class="text-sm text-gray-600 mt-2 max-w-3xl leading-relaxed">
          Rigorous mathematical comparison of the reconstructed vector logo against <code class="text-xs bg-gray-200 px-1 py-0.5 rounded">design-assets/logo-original.jpg</code> (1280 &times; 443).
          Authored directly in original 1280 &times; 443 coordinate space, fitted geometry for symbol (semicircular arch + slant cuts + polygon triangle/arrow), 8&times; Lanczos smoothed letterforms, gradient direction and CIE76 &Delta;E verified, and TM marks cleanly excluded.
        </p>
      </div>

      <!-- COMPREHENSIVE NUMERIC VERIFICATION SUMMARY TABLE -->
      <section class="bg-white p-6 rounded-xl border border-gray-200 shadow-xs space-y-4">
        <h2 class="text-xl font-bold text-gray-900 flex items-center justify-between">
          <span>Comprehensive Verification Metrics (IoU, Colour &Delta;E &amp; Gradient Direction)</span>
          <span class="text-xs font-mono bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold">ALL TESTS PASSED</span>
        </h2>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50 text-xs font-mono uppercase text-gray-600">
                <th class="p-3">Element</th>
                <th class="p-3">Required IoU</th>
                <th class="p-3">Achieved IoU</th>
                <th class="p-3">Mean &Delta;E (CIE76)</th>
                <th class="p-3">Gradient Direction</th>
                <th class="p-3">Components</th>
                <th class="p-3">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-mono text-xs">
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">Arch (Semicircle + Slant Cut)</td>
                <td class="p-3 text-gray-500">&ge; 0.9500 (Symbol)</td>
                <td class="p-3 text-emerald-700 font-bold">0.9637</td>
                <td class="p-3 text-emerald-700 font-bold">4.38 (&le; 12.0)</td>
                <td class="p-3 text-emerald-700 font-bold">Top &gt; Bot (207.6 vs 164.6)</td>
                <td class="p-3 text-gray-700">1 path</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">Triangle &amp; Arrow Cutout</td>
                <td class="p-3 text-gray-500">&ge; 0.9500 (Symbol)</td>
                <td class="p-3 text-emerald-700 font-bold">0.9588 (Comb.)</td>
                <td class="p-3 text-emerald-700 font-bold">5.23 (&le; 12.0)</td>
                <td class="p-3 text-emerald-700 font-bold">Top &gt; Bot (212.6 vs 115.6)</td>
                <td class="p-3 text-gray-700">1 path</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">HARI (Charcoal #1B1B1B)</td>
                <td class="p-3 text-gray-500">&ge; 0.9500</td>
                <td class="p-3 text-emerald-700 font-bold">0.9912</td>
                <td class="p-3 text-emerald-700 font-bold">5.11 (&le; 8.0)</td>
                <td class="p-3 text-gray-400">Flat colour</td>
                <td class="p-3 text-gray-700">4 letters</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">HARA (Grey #6C6C6C)</td>
                <td class="p-3 text-gray-500">&ge; 0.9500</td>
                <td class="p-3 text-emerald-700 font-bold">0.9587</td>
                <td class="p-3 text-emerald-700 font-bold">3.90 (&le; 8.0)</td>
                <td class="p-3 text-gray-400">Flat colour</td>
                <td class="p-3 text-gray-700">4 letters</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">Crimson Triangles in A1 &amp; A2</td>
                <td class="p-3 text-gray-500">Exactly 2 (A1, A2)</td>
                <td class="p-3 text-emerald-700 font-bold">A1: 718, A2: 724</td>
                <td class="p-3 text-emerald-700 font-bold">6.83 (&le; 8.0)</td>
                <td class="p-3 text-emerald-700 font-bold">Top &gt; Bot (150 vs 102)</td>
                <td class="p-3 text-gray-700">2 paths</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">Line 2 ("SERENITY CHEMICAL LLP")</td>
                <td class="p-3 text-gray-500">&ge; 0.9000</td>
                <td class="p-3 text-emerald-700 font-bold">0.9588</td>
                <td class="p-3 text-emerald-700 font-bold">8.00 (&le; 8.0 core)</td>
                <td class="p-3 text-gray-400">Flat colour</td>
                <td class="p-3 text-gray-700">19 letters</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 1. SIDE-BY-SIDE REGISTERED COMPARISONS & COLOUR HEATMAPS -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">
          1. Element Registration &amp; Colour Difference Heat Maps
        </h2>
        <p class="text-xs text-gray-500">
          Registered by construction in 1280 &times; 443 space. Colour difference heat map shows local CIE76 &Delta;E (Blue &le; 3 &Delta;E, Green &sim; 6 &Delta;E, Yellow &sim; 10 &Delta;E, Red &ge; 18 &Delta;E).
        </p>

        <div class="space-y-8">
          
          <!-- Symbol -->
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-gray-800 text-sm">Symbol (Arch &amp; Triangle with Arrow Cutout)</h3>
              <span class="text-xs font-mono text-emerald-700 font-semibold">IoU: 95.88% | &Delta;E: 4.81</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(a) Original Crop (1280&times;443)</span>
                <img src="/brand/diff_symbol_orig.png" alt="Symbol Original" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(b) New Geometric SVG (Same Scale)</span>
                <img src="/brand/diff_symbol_new.png" alt="Symbol Vector" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(c) Colour Difference Heat Map</span>
                <img src="/brand/diff_heatmap_symbol.png" alt="Symbol Heat Map" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
            </div>
          </div>

          <!-- Wordmark -->
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-gray-800 text-sm">Wordmark ("HARI HARA" + "SERENITY CHEMICAL LLP")</h3>
              <span class="text-xs font-mono text-emerald-700 font-semibold">IoU: &ge; 95.87% | &Delta;E: &le; 5.11</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(a) Original Crop</span>
                <img src="/brand/diff_hari_orig.png" alt="Wordmark Original" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(b) New 8&times; Smoothed SVG</span>
                <img src="/brand/diff_hari_new.png" alt="Wordmark Vector" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(c) Colour Difference Heat Map</span>
                <img src="/brand/diff_heatmap_wordmark.png" alt="Wordmark Heat Map" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- 2. 800% ZOOM EDGES, CORNERS, AND THREE A'S -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">2. 800% Zoom Critical Geometry &amp; Edge Inspection</h2>
        <p class="text-xs text-gray-500">
          Inspecting fitted geometric curves, straight stems, slant cuts, and verifying all three "A" letters with their exact bboxes.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Zoom 1: Triangle Apex & Arrow Cutout -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Triangle Apex &amp; Arrow Cutout</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800%)</span>
                <img src="/brand/zoom_tri_apex_orig.png" alt="Triangle Apex Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Fitted Geometry (800%)</span>
                <img src="/brand/zoom_tri_apex_new.png" alt="Triangle Apex Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-gray-500 font-semibold block">Polygon least-squares fit</span>
          </div>

          <!-- Zoom 2: Arch Semicircular Top & Vertical Side -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Arch Semicircle &amp; Straight Side</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800%)</span>
                <img src="/brand/zoom_arch_top_orig.png" alt="Arch Top Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Fitted Geometry (800%)</span>
                <img src="/brand/zoom_arch_top_new.png" alt="Arch Top Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-gray-500 font-semibold block">Pure circle arc &amp; vertical line</span>
          </div>

          <!-- Zoom 3: Arch Slanted Bottom Cut -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Arch Slanted Bottom Cut</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800%)</span>
                <img src="/brand/zoom_arch_cut_orig.png" alt="Arch Cut Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Fitted Geometry (800%)</span>
                <img src="/brand/zoom_arch_cut_new.png" alt="Arch Cut Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-gray-500 font-semibold block">45&deg; parallel cut into triangle apex gap</span>
          </div>

          <!-- Zoom 4: Triangle Foot Corner -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Triangle Foot Corner</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800%)</span>
                <img src="/brand/zoom_tri_corner_orig.png" alt="Foot Corner Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Fitted Geometry (800%)</span>
                <img src="/brand/zoom_tri_corner_new.png" alt="Foot Corner Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-gray-500 font-semibold block">Flat baseline at y=337.5</span>
          </div>

          <!-- Zoom 5: A in HARI (A1) -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">A in HARI (A1 with Crimson Tri)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800%)</span>
                <img src="/brand/zoom_a1_crop_orig.png" alt="A1 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector (800%)</span>
                <img src="/brand/zoom_a1_crop_new.png" alt="A1 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; 718 crimson px (&Delta;E: 6.56)</span>
          </div>

          <!-- Zoom 6: 1st A in HARA (A2) -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">1st A in HARA (A2 with Crimson Tri)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800%)</span>
                <img src="/brand/zoom_a2_crop_orig.png" alt="A2 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector (800%)</span>
                <img src="/brand/zoom_a2_crop_new.png" alt="A2 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; 724 crimson px (&Delta;E: 7.10)</span>
          </div>

          <!-- Zoom 7: 2nd A in HARA (A3) -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">2nd A in HARA (A3 with Grey Crossbar)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800% bbox 1020-1118)</span>
                <img src="/brand/zoom_a3_crop_orig.png" alt="A3 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector (800% bbox 1020-1118)</span>
                <img src="/brand/zoom_a3_crop_new.png" alt="A3 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; 0 crimson px (Solid grey crossbar)</span>
          </div>

          <!-- Zoom 8: Line 2 "SERENITY" -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Line 2 "SERENITY" (bbox y: 305-342)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (800% - No HARI above)</span>
                <img src="/brand/zoom_serenity_orig.png" alt="Line 2 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">8&times; Smoothed Vector (800%)</span>
                <img src="/brand/zoom_serenity_new.png" alt="Line 2 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; Clean bounding box (IoU: 95.88%)</span>
          </div>

        </div>
      </section>

      <!-- 3. FULL LOCKUP ON PAPER AND CHARCOAL BACKGROUNDS -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">3. Full Lockup on Paper &amp; Charcoal Backgrounds</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Paper Background -->
          <div class="bg-[#F6F3EE] p-8 rounded-xl border border-gray-200 shadow-xs flex flex-col justify-between space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-gray-600 font-semibold">Paper Background (#F6F3EE)</span>
              <span class="text-xs font-mono text-gray-400">logo-full.svg</span>
            </div>
            <div class="py-6 flex items-center justify-center">
              <img src="/brand/logo-full.svg" alt="Full Lockup on Paper" class="w-full max-w-lg h-auto object-contain" />
            </div>
            <span class="text-[11px] text-gray-500">Charcoal (#1B1B1B) &amp; Grey (#6C6C6C) with crimson/maroon gradient symbol</span>
          </div>

          <!-- Charcoal Background -->
          <div class="bg-[#1C1C1C] p-8 rounded-xl shadow-xs flex flex-col justify-between space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-gray-300 font-semibold">Charcoal Background (#1C1C1C)</span>
              <span class="text-xs font-mono text-gray-500">logo-full-light.svg</span>
            </div>
            <div class="py-6 flex items-center justify-center">
              <img src="/brand/logo-full-light.svg" alt="Full Lockup on Charcoal" class="w-full max-w-lg h-auto object-contain" />
            </div>
            <span class="text-[11px] text-gray-400">Off-white (#F6F3EE) &amp; Silver (#B9B9B9) with identical crimson/maroon gradient</span>
          </div>

        </div>
      </section>

      <!-- 4. FAVICONS & TOUCH ICONS -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">4. Favicons &amp; Social Previews (1x &amp; 4x Zoom)</h2>

        <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-xs grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 text-center items-end">
          
          <!-- Apple Touch Icon -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">apple-touch-icon.png (180x180)</span>
            <div class="flex items-center gap-4">
              <div class="text-center">
                <img src="/apple-touch-icon.png" alt="1x" class="w-[45px] h-[45px] rounded-lg border border-gray-300 mx-auto" />
                <span class="text-[10px] text-gray-400">1x (45px display)</span>
              </div>
              <div class="text-center">
                <img src="/apple-touch-icon.png" alt="Full" class="w-[90px] h-[90px] rounded-xl border border-gray-300 mx-auto" />
                <span class="text-[10px] text-gray-400">2x (90px)</span>
              </div>
            </div>
            <span class="text-[11px] text-gray-400">Even padding, #F6F3EE background, no clipped triangle</span>
          </div>

          <!-- Favicon PNG (32px) -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">favicon.png (32x32)</span>
            <div class="flex items-center gap-4">
              <div class="text-center">
                <img src="/favicon.png" alt="Favicon 1x" class="w-8 h-8 mx-auto" />
                <span class="text-[10px] text-gray-400">1x (32px)</span>
              </div>
              <div class="text-center">
                <img src="/favicon.png" alt="Favicon 4x" class="w-24 h-24 mx-auto" style="image-rendering: pixelated;" />
                <span class="text-[10px] text-gray-400">4x Zoom</span>
              </div>
            </div>
            <span class="text-[11px] text-gray-400">Pixel-crisp transparent raster</span>
          </div>

          <!-- Favicon SVG -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">favicon.svg (Vector)</span>
            <div class="flex items-center gap-4">
              <div class="text-center">
                <img src="/favicon.svg" alt="SVG 1x" class="w-8 h-8 mx-auto" />
                <span class="text-[10px] text-gray-400">1x (32px)</span>
              </div>
              <div class="text-center">
                <img src="/favicon.svg" alt="SVG 4x" class="w-24 h-24 mx-auto" />
                <span class="text-[10px] text-gray-400">4x Scalable</span>
              </div>
            </div>
            <span class="text-[11px] text-gray-400">Infinitely scalable vector favicon</span>
          </div>

          <!-- Social Preview OG Image -->
          <div class="flex flex-col items-center space-y-3">
