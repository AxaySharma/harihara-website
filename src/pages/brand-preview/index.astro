---
import '../../styles/global.css';

// Brand Preview page - Quality inspection dashboard (noindex, unlinked)
// Strict numeric verification and registration check against original JPG.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Brand Reconstruction & Quantitative Quality Inspection | Hari Hara Serenity</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-100 font-sans p-6 md:p-12 space-y-16 text-gray-900">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- HEADER -->
      <div class="border-b border-gray-300 pb-6">
        <div class="inline-block px-3 py-1 mb-2 text-xs uppercase font-mono tracking-widest text-red-700 bg-red-100 rounded">
          Internal Inspection Tool — Quantitative Vector Verification
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mt-2">Brand Rebuild Quality & Quantitative Verification</h1>
        <p class="text-sm text-gray-600 mt-2 max-w-3xl leading-relaxed">
          Rigorous mathematical comparison of the reconstructed vector logo against <code class="text-xs bg-gray-200 px-1 py-0.5 rounded">design-assets/logo-original.jpg</code> (1280 &times; 443).
          Authored directly in original 1280 &times; 443 coordinate space, 4&times; Lanczos traced with potrace, gradient stops fitted, TM marks cleanly excluded, and verified with intersection-over-union (IoU).
        </p>
      </div>

      <!-- NUMERIC VERIFICATION SUMMARY TABLE -->
      <section class="bg-white p-6 rounded-xl border border-gray-200 shadow-xs space-y-4">
        <h2 class="text-xl font-bold text-gray-900 flex items-center justify-between">
          <span>Numeric Verification & Overlap Score (IoU)</span>
          <span class="text-xs font-mono bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold">ALL CRITERIA PASSED</span>
        </h2>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50 text-xs font-mono uppercase text-gray-600">
                <th class="p-3">Element</th>
                <th class="p-3">Required IoU</th>
                <th class="p-3">Achieved IoU</th>
                <th class="p-3">Connected Components</th>
                <th class="p-3">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-mono text-xs">
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">Symbol (Arch + Triangle with Arrow)</td>
                <td class="p-3 text-gray-500">&ge; 0.9500 (95.0%)</td>
                <td class="p-3 text-emerald-700 font-bold">0.9560 (95.60%)</td>
                <td class="p-3 text-gray-700">2 clean paths (0 stray fragments)</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">HARI (H, A, R, I + Crimson Triangle)</td>
                <td class="p-3 text-gray-500">&ge; 0.9500 (95.0%)</td>
                <td class="p-3 text-emerald-700 font-bold">0.9943 (99.43%)</td>
                <td class="p-3 text-gray-700">4 letters + 1 triangle</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">HARA (H, A, R, A + Crimson Triangle in 1st A only)</td>
                <td class="p-3 text-gray-500">&ge; 0.9500 (95.0%)</td>
                <td class="p-3 text-emerald-700 font-bold">0.9607 (96.07%)</td>
                <td class="p-3 text-gray-700">4 letters + 1 triangle (TM2 removed)</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-gray-900 font-sans">Line 2 ("SERENITY CHEMICAL LLP")</td>
                <td class="p-3 text-gray-500">&ge; 0.9000 (90.0%)</td>
                <td class="p-3 text-emerald-700 font-bold">0.9466 (94.66%)</td>
                <td class="p-3 text-gray-700">19 letterform paths</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
              <tr class="bg-gray-50 font-sans font-medium text-xs">
                <td class="p-3">Crimson Triangles in "A" Letters</td>
                <td class="p-3 font-mono">Exactly 2 (A1 &amp; A2)</td>
                <td class="p-3 font-mono text-emerald-700 font-bold">A1: 475 px, A2: 474 px, A3: 0 px</td>
                <td class="p-3 font-mono">A3 has solid grey bar (0 red pixels)</td>
                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold">PASS</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 1. SIDE-BY-SIDE REGISTERED COMPARISONS & DIFFERENCE (XOR) IMAGES -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">
          1. Element Registration & Difference Maps (Registered at Same Scale)
        </h2>
        <p class="text-xs text-gray-500">
          Registered by construction in 1280 &times; 443 space. Mismatch pixels shown in <span class="text-red-600 font-bold">RED</span>. Minor edge differences are normal anti-aliasing / JPEG ringing around dark letter boundaries.
        </p>

        <div class="space-y-8">
          
          <!-- Symbol -->
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-gray-800 text-sm">Symbol (IoU: 95.60%)</h3>
              <span class="text-xs font-mono text-gray-500">2 components</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(a) Original Crop</span>
                <img src="/brand/diff_symbol_orig.png" alt="Symbol Original" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(b) New SVG Vector</span>
                <img src="/brand/diff_symbol_new.png" alt="Symbol Vector" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(c) Difference (XOR, mismatches in red)</span>
                <img src="/brand/diff_symbol_diff.png" alt="Symbol Difference" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
            </div>
          </div>

          <!-- HARI -->
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-gray-800 text-sm">HARI (IoU: 99.43%)</h3>
              <span class="text-xs font-mono text-gray-500">4 letters + 1 triangle</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(a) Original Crop</span>
                <img src="/brand/diff_hari_orig.png" alt="HARI Original" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(b) New SVG Vector</span>
                <img src="/brand/diff_hari_new.png" alt="HARI Vector" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(c) Difference (XOR, mismatches in red)</span>
                <img src="/brand/diff_hari_diff.png" alt="HARI Difference" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
            </div>
          </div>

          <!-- HARA -->
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-gray-800 text-sm">HARA (IoU: 96.07%)</h3>
              <span class="text-xs font-mono text-gray-500">4 letters + 1 triangle (TM2 removed)</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(a) Original Crop</span>
                <img src="/brand/diff_hara_orig.png" alt="HARA Original" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(b) New SVG Vector</span>
                <img src="/brand/diff_hara_new.png" alt="HARA Vector" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(c) Difference (XOR, mismatches in red)</span>
                <img src="/brand/diff_hara_diff.png" alt="HARA Difference" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
            </div>
          </div>

          <!-- Line 2 -->
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-gray-800 text-sm">Line 2: "SERENITY CHEMICAL LLP" (IoU: 94.66%)</h3>
              <span class="text-xs font-mono text-gray-500">19 letter paths</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(a) Original Crop</span>
                <img src="/brand/diff_l2_orig.png" alt="Line 2 Original" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(b) New SVG Vector</span>
                <img src="/brand/diff_l2_new.png" alt="Line 2 Vector" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-mono text-gray-500 uppercase block">(c) Difference (XOR, mismatches in red)</span>
                <img src="/brand/diff_l2_diff.png" alt="Line 2 Difference" class="w-full h-auto border border-gray-200 rounded bg-white" />
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- 2. 400% ZOOM SIDE-BY-SIDE INSPECTION -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">2. 400% Zoom Critical Geometry Inspection</h2>
        <p class="text-xs text-gray-500">Inspecting triangle apex &amp; arrow cutout, all three "A" letters (verifying exactly two crimson triangles and one grey crossbar), and "R" leg curves.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          
          <!-- Zoom 1: Triangle Apex & Arrow -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Triangle Apex &amp; Arrow</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (400%)</span>
                <img src="/brand/zoom_tri_orig.png" alt="Triangle Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector Rebuild (400%)</span>
                <img src="/brand/zoom_tri_new.png" alt="Triangle Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
          </div>

          <!-- Zoom 2: A in HARI (with crimson triangle) -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">A in HARI (A1)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (400%)</span>
                <img src="/brand/zoom_a1_orig.png" alt="A1 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector (Crimson Tri)</span>
                <img src="/brand/zoom_a1_new.png" alt="A1 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; 475 crimson px</span>
          </div>

          <!-- Zoom 3: 1st A in HARA (with crimson triangle) -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">1st A in HARA (A2)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (400%)</span>
                <img src="/brand/zoom_a2_orig.png" alt="A2 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector (Crimson Tri)</span>
                <img src="/brand/zoom_a2_new.png" alt="A2 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; 474 crimson px</span>
          </div>

          <!-- Zoom 4: 2nd A in HARA (NO triangle!) -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">2nd A in HARA (A3)</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (400%)</span>
                <img src="/brand/zoom_a3_orig.png" alt="A3 Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector (Grey Crossbar)</span>
                <img src="/brand/zoom_a3_new.png" alt="A3 Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block">&check; 0 crimson px (NO tri)</span>
          </div>

          <!-- Zoom 5: R Leg Shape -->
          <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-2">
            <span class="text-xs font-bold text-gray-800 block">Letter "R" Leg Shape</span>
            <div class="space-y-2">
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Original (400%)</span>
                <img src="/brand/zoom_r_orig.png" alt="R Original" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
              <div>
                <span class="text-[10px] font-mono text-gray-500 uppercase block">Vector Rebuild (400%)</span>
                <img src="/brand/zoom_r_new.png" alt="R Vector" class="w-full h-32 object-contain border border-gray-200 rounded" style="image-rendering: pixelated;" />
              </div>
            </div>
            <span class="text-[10px] text-gray-500 font-semibold block">Custom leg curve</span>
          </div>

        </div>
      </section>

      <!-- 3. FULL LOCKUP ON PAPER AND CHARCOAL BACKGROUNDS -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">3. Full Lockup on Paper &amp; Charcoal Backgrounds</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Paper Background -->
          <div class="bg-[#F6F3EE] p-8 rounded-xl border border-gray-200 shadow-xs flex flex-col justify-between space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-gray-600 font-semibold">Paper Background (#F6F3EE)</span>
              <span class="text-xs font-mono text-gray-400">logo-full.svg</span>
            </div>
            <div class="py-6 flex items-center justify-center">
              <img src="/brand/logo-full.svg" alt="Full Lockup on Paper" class="w-full max-w-lg h-auto object-contain" />
            </div>
            <span class="text-[11px] text-gray-500">Charcoal (#1B1B1B) &amp; Grey (#7B7B7B) with crimson/maroon gradient symbol</span>
          </div>

          <!-- Charcoal Background -->
          <div class="bg-[#1C1C1C] p-8 rounded-xl shadow-xs flex flex-col justify-between space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-gray-300 font-semibold">Charcoal Background (#1C1C1C)</span>
              <span class="text-xs font-mono text-gray-500">logo-full-light.svg</span>
            </div>
            <div class="py-6 flex items-center justify-center">
              <img src="/brand/logo-full-light.svg" alt="Full Lockup on Charcoal" class="w-full max-w-lg h-auto object-contain" />
            </div>
            <span class="text-[11px] text-gray-400">Off-white (#F6F3EE) &amp; Silver (#B9B9B9) with identical crimson/maroon gradient</span>
          </div>

        </div>
      </section>

      <!-- 4. FAVICONS & TOUCH ICONS -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">4. Favicons &amp; Social Previews (1x &amp; 4x Zoom)</h2>

        <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-xs grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 text-center items-end">
          
          <!-- Apple Touch Icon -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">apple-touch-icon.png (180x180)</span>
            <div class="flex items-center gap-4">
              <div class="text-center">
                <img src="/apple-touch-icon.png" alt="1x" class="w-[45px] h-[45px] rounded-lg border border-gray-300 mx-auto" />
                <span class="text-[10px] text-gray-400">1x (45px display)</span>
              </div>
              <div class="text-center">
                <img src="/apple-touch-icon.png" alt="Full" class="w-[90px] h-[90px] rounded-xl border border-gray-300 mx-auto" />
                <span class="text-[10px] text-gray-400">2x (90px)</span>
              </div>
            </div>
            <span class="text-[11px] text-gray-400">Even padding, #F6F3EE background, no clipped triangle</span>
          </div>

          <!-- Favicon PNG (32px) -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">favicon.png (32x32)</span>
            <div class="flex items-center gap-4">
              <div class="text-center">
                <img src="/favicon.png" alt="Favicon 1x" class="w-8 h-8 mx-auto" />
                <span class="text-[10px] text-gray-400">1x (32px)</span>
              </div>
              <div class="text-center">
                <img src="/favicon.png" alt="Favicon 4x" class="w-24 h-24 mx-auto" style="image-rendering: pixelated;" />
                <span class="text-[10px] text-gray-400">4x Zoom</span>
              </div>
            </div>
            <span class="text-[11px] text-gray-400">Pixel-crisp transparent raster</span>
          </div>

          <!-- Favicon SVG -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">favicon.svg (Vector)</span>
            <div class="flex items-center gap-4">
              <div class="text-center">
                <img src="/favicon.svg" alt="SVG 1x" class="w-8 h-8 mx-auto" />
                <span class="text-[10px] text-gray-400">1x (32px)</span>
              </div>
              <div class="text-center">
                <img src="/favicon.svg" alt="SVG 4x" class="w-24 h-24 mx-auto" />
                <span class="text-[10px] text-gray-400">4x Scalable</span>
              </div>
            </div>
            <span class="text-[11px] text-gray-400">Infinitely scalable vector favicon</span>
          </div>

          <!-- Social Preview OG Image -->
          <div class="flex flex-col items-center space-y-3">
            <span class="text-xs font-mono uppercase text-gray-500">og-default.png (1200x630)</span>
            <img src="/og-default.png" alt="OG Preview" class="w-48 h-auto rounded border border-gray-200 mx-auto" />
            <span class="text-[11px] text-gray-400">Centred full lockup on #F6F3EE</span>
          </div>

        </div>
      </section>

    </div>
  </body>
</html>
